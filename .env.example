AC_BASE_URL=http://example.local:8081
AC_USERNAME=your_username
AC_KEYCHAIN_SERVICE=company-ac
AC_PANEL_HOST=127.0.0.1
AC_PANEL_PORT=3033
AC_PANEL_TITLE=AC Control
AC_PANEL_UNIT_COLUMNS=VAV_01,VAV_03|VAV_02,VAV_04
AC_RUNTIME_STATE_FILE=runtime-state.json
# Optional: receive JSON notifications for failed control/watchdog events.
# AC_NOTIFY_WEBHOOK=
AC_VERIFY_TIMEOUT_MS=60000
AC_VERIFY_INTERVAL_MS=3000
# Timeout for a single request to the Niagara station. Raise it when the panel reaches
# the station over a WAN/VPN link; the default tolerates a slow round trip.
# AC_REQUEST_TIMEOUT_MS=20000
# Scheduled controls default to 3 attempts and 60 seconds between attempts.
# Set these only if you want to override scheduled controls.
# AC_CONTROL_ATTEMPTS=3
# AC_CONTROL_RETRY_DELAY_MS=60000
# Panel and manual commands only retry transient network blips, a few times quickly and
# inside a total budget so an interactive action still returns an answer.
# AC_INTERACTIVE_ATTEMPTS=3
# AC_INTERACTIVE_RETRY_DELAY_MS=3000
# AC_INTERACTIVE_BUDGET_MS=75000
# Status reads get one quick retry, because the panel waits on a fixed budget.
# AC_STATUS_ATTEMPTS=2
# AC_STATUS_RETRY_DELAY_MS=2000
# AC_STATUS_BUDGET_MS=40000

AC_MODE_ORD=station:|slot:/Drivers/NiagaraNetwork/DEVICE/points/MODE
AC_TEMP_ORD=station:|slot:/Drivers/NiagaraNetwork/DEVICE/points/TEMP_SETPOINT
AC_VAV_BASE_ORD=station:|slot:/Drivers/NiagaraNetwork/DEVICE/points
AC_VAVS=VAV_01,VAV_02

# Do not commit real passwords. macOS stores the password in Keychain.
# Windows scheduled tasks are non-interactive, so set AC_PASSWORD in the local ignored .env file.
# AC_PASSWORD=
